root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# noinspection EditorConfigKeyCorrectness
[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_standard_package-name = disabled
